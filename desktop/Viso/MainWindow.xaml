<Window xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:local="clr-namespace:Viso;assembly=Viso"
        Title="Viso" Width="1040" Height="820" MinWidth="780" MinHeight="680"
        WindowStartupLocation="CenterScreen" Background="#141619" Foreground="#F3F5F8"
        FontFamily="Segoe UI" FontSize="13" UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="6" CornerRadius="12" GlassFrameThickness="0" UseAeroCaptionButtons="False" /></shell:WindowChrome.WindowChrome>
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#959DAA" />
    <SolidColorBrush x:Key="Accent" Color="#3499FF" />
    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style x:Key="Detail" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Muted}"/><Setter Property="FontSize" Value="12"/><Setter Property="LineHeight" Value="19"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
    <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#1C1F24"/><Setter Property="BorderBrush" Value="#2C3037"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="18"/><Setter Property="Padding" Value="24"/></Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="Background" Value="#292E36"/><Setter Property="BorderBrush" Value="#3C424B"/><Setter Property="Padding" Value="18,11"/><Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Cursor" Value="Hand"/><Setter Property="MinHeight" Value="38"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
        <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#6D9BC9"/></Trigger><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#9DCDFF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.38"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#3499FF"/><Setter Property="BorderBrush" Value="#5DADFF"/><Setter Property="Foreground" Value="#061729"/></Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#AEB7C4"/></Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Padding" Value="18,12"/><Setter Property="MinWidth" Value="112"/></Style>
    <Style x:Key="Caption" TargetType="Button" BasedOn="{StaticResource Quiet}"><Setter Property="Padding" Value="0"/><Setter Property="Width" Value="44"/><Setter Property="Height" Value="38"/><Setter Property="MinHeight" Value="0"/><Setter Property="FontFamily" Value="Segoe MDL2 Assets"/><Setter Property="FontSize" Value="10"/><Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/></Style>
    <Style TargetType="TextBox">
      <Setter Property="Foreground" Value="#F3F5F8"/><Setter Property="Background" Value="#14171B"/><Setter Property="BorderBrush" Value="#414854"/><Setter Property="CaretBrush" Value="White"/>
      <Setter Property="Padding" Value="12,6"/><Setter Property="MinHeight" Value="40"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
        <Border x:Name="Frame" CornerRadius="9" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Background="{TemplateBinding Background}">
          <!-- TextBox forwards Padding to its content host; an extra margin clips the text. -->
          <ScrollViewer x:Name="PART_ContentHost" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
        </Border>
        <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#3499FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#EAF0F7"/><Setter Property="FontSize" Value="14"/><Setter Property="VerticalContentAlignment" Value="Center"/></Style>
    <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#DFE8F3"/><Setter Property="Background" Value="#252B33"/><Setter Property="Padding" Value="12,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Row" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Row" Property="Background" Value="#3D5066"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#33465B"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#DFE8F3"/><Setter Property="Background" Value="#252B33"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
      <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="Frame" CornerRadius="8" Background="#252B33" BorderBrush="#454E5B" BorderThickness="1"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,3" VerticalAlignment="Center" Foreground="#B5C7DC"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#6D9BC9"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton>
      <ContentPresenter Margin="12,8,32,8" IsHitTestVisible="False" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" VerticalAlignment="Center"/>
      <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#252B33" BorderBrush="#454E5B" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="260"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
    </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="Background" Value="#34495F"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="ScrollBar"><Setter Property="Width" Value="9"/><Setter Property="Background" Value="Transparent"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Track x:Name="PART_Track" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#424A56" CornerRadius="3" Margin="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton></Track></ControlTemplate></Setter.Value></Setter></Style>
    <Style x:Key="SliderTrackButton" TargetType="RepeatButton"><Setter Property="Focusable" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RepeatButton"><Border Height="3" CornerRadius="1.5" Background="{TemplateBinding Background}"/></ControlTemplate></Setter.Value></Setter></Style>
    <Style TargetType="Slider"><Setter Property="Height" Value="24"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid><Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"><Track.DecreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackButton}" Background="#3499FF" Command="{x:Static Slider.DecreaseLarge}"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb Width="14" Height="14"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Fill="#BFDEFF" Stroke="#3499FF" StrokeThickness="3"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Style="{StaticResource SliderTrackButton}" Background="#465363" Command="{x:Static Slider.IncreaseLarge}"/></Track.IncreaseRepeatButton></Track></Grid><ControlTemplate.Triggers><Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="Background" Value="#283F56"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  </Window.Resources>
  <Grid Background="#141619">
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/><RowDefinition Height="90"/></Grid.RowDefinitions>
    <Grid x:Name="TitleBar" Margin="22,0,8,0">
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="viso" FontSize="23" FontWeight="Bold"/><TextBlock Text="·" Foreground="{StaticResource Accent}" FontSize="26" Margin="2,-3,0,0"/><TextBlock Text="FOR WINDOWS" Foreground="#6F7987" FontSize="9" FontWeight="SemiBold" Margin="14,10,0,0"/></StackPanel>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="MinimizeButton" Style="{StaticResource Caption}" Content="&#xE921;" AutomationProperties.Name="Minimize"/><Button x:Name="MaximizeButton" Style="{StaticResource Caption}" Content="&#xE922;" AutomationProperties.Name="Maximize or restore"/><Button x:Name="CloseButton" Style="{StaticResource Caption}" Content="&#xE8BB;" AutomationProperties.Name="Close"/></StackPanel>
    </Grid>
    <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel x:Name="PageContent" Margin="38,16,38,8" MaxWidth="1080">
        <Grid Margin="0,0,0,24"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <StackPanel><TextBlock x:Name="PageEyebrow" Text="YOUR FACE, YOUR KEY" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Accent}"/><TextBlock x:Name="PageTitle" Text="A little more effortless." FontSize="31" FontWeight="SemiBold" Margin="0,7,0,6"/><TextBlock x:Name="PageSubtitle" Text="Two gentle circles. A more complete view." Style="{StaticResource Detail}"/></StackPanel>
          <Border Grid.Column="1" Background="#20272A" CornerRadius="16" Padding="12,7" VerticalAlignment="Top" Margin="16,4,0,0"><StackPanel Orientation="Horizontal"><Ellipse x:Name="EngineDot" Width="6" Height="6" Fill="#9CA7B7" Margin="0,0,7,0"/><TextBlock x:Name="EngineStatus" Text="Starting engine" MinWidth="100" TextWrapping="NoWrap" FontSize="11" Foreground="#C4CED9"/></StackPanel></Border>
        </Grid>
        <Border x:Name="Notice" Visibility="Collapsed" Background="#302425" BorderBrush="#644246" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,0,0,16"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="NoticeText" Foreground="#F2BAC0" VerticalAlignment="Center"/><Button x:Name="DismissNotice" Grid.Column="1" Content="Dismiss" Style="{StaticResource Quiet}" Padding="12,3" MinHeight="28" Margin="12,0,0,0"/></Grid></Border>

        <StackPanel x:Name="CapturePage">
          <Border Style="{StaticResource Card}">
            <StackPanel>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="CaptureLabel" Text="FACE ENROLLMENT" FontSize="10" FontWeight="SemiBold" Foreground="#A4ADBA" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="InspectFrame" Content="Inspect frame" Style="{StaticResource Quiet}" MinHeight="0" Height="24" Padding="8,3" FontSize="10" Margin="0,0,12,0"/><Ellipse x:Name="CameraDot" Width="5" Height="5" Fill="#707986" Margin="0,0,6,0"/><TextBlock x:Name="CameraStatus" Text="Camera off" FontSize="11" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/></StackPanel></Grid>
              <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Viewbox Stretch="Uniform" MaxWidth="296" MaxHeight="296" Margin="-6,0,10,0"><Grid Width="340" Height="340">
                  <Ellipse Width="246" Height="246" Fill="#121519" Stroke="#292F38"/>
                  <Ellipse x:Name="CameraViewport" Width="246" Height="246" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- Fill and mirror within fixed bounds, independent of the frame's aspect ratio. -->
                    <Ellipse.Fill><ImageBrush x:Name="CameraPreview" Stretch="UniformToFill" AlignmentX="Center" AlignmentY="Center"><ImageBrush.RelativeTransform><ScaleTransform ScaleX="-1" CenterX="0.5" CenterY="0.5"/></ImageBrush.RelativeTransform></ImageBrush></Ellipse.Fill>
                  </Ellipse>
                  <StackPanel x:Name="FacePlaceholder" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <Viewbox Width="72" Height="72" Margin="0,0,0,14"><Canvas Width="80" Height="80"><Path Data="M 22,5 L 13,5 Q 5,5 5,13 L 5,22 M 58,5 L 67,5 Q 75,5 75,13 L 75,22 M 5,58 L 5,67 Q 5,75 13,75 L 22,75 M 58,75 L 67,75 Q 75,75 75,67 L 75,58" Stroke="#ADC1D8" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Path Data="M 25,27 L 25,34 M 55,27 L 55,34 M 40,28 L 40,43 L 35,43 M 25,53 Q 40,66 55,53" Stroke="#ADC1D8" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox>
                    <TextBlock Text="Ready when you are" FontSize="12" Foreground="#8493A6" HorizontalAlignment="Center"/>
                  </StackPanel>
                  <local:EnrollmentRing x:Name="FaceRing" Width="340" Height="340"/>
                  <Border x:Name="SuccessBadge" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,18" Background="#254B41" CornerRadius="16" Padding="14,6"><TextBlock Text="✓  All set" Foreground="#9CE4C7" FontSize="12" FontWeight="SemiBold"/></Border>
                </Grid></Viewbox>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0,0,0">
                  <TextBlock x:Name="GuideKicker" Text="LET’S GET ACQUAINTED" FontSize="10" FontWeight="SemiBold" Foreground="#6EAAE8" Margin="0,0,0,10"/>
                  <TextBlock x:Name="GuideTitle" Text="Your face belongs here." FontSize="23" FontWeight="SemiBold" Margin="0,0,0,10"/>
                  <TextBlock x:Name="GuideDescription" Text="Find some even light, sit comfortably, and keep your camera at eye level." Style="{StaticResource Detail}" Margin="0,0,0,20"/>
                  <StackPanel x:Name="PoseList">
                    <TextBlock x:Name="Pose0" Text="○   Look straight ahead" Margin="0,0,0,12" Foreground="#D2D8E0"/>
                    <TextBlock x:Name="Pose1" Text="○   Turn a little left" Margin="0,0,0,12" Foreground="#788391"/>
                    <TextBlock x:Name="Pose2" Text="○   Turn a little right" Margin="0,0,0,12" Foreground="#788391"/>
                    <TextBlock x:Name="Pose3" Text="○   Gently look up" Margin="0,0,0,12" Foreground="#788391"/>
                    <TextBlock x:Name="Pose4" Text="○   Gently look down" Foreground="#788391"/>
                  </StackPanel>
                  <Border x:Name="UnlockState" Visibility="Collapsed" Background="#252B34" CornerRadius="12" Padding="16"><StackPanel><TextBlock x:Name="UnlockLabel" Text="●  Simulator locked" FontWeight="SemiBold"/><TextBlock x:Name="UnlockDetail" Text="Match your face, blink when prompted, then reopen both eyes." Style="{StaticResource Detail}" Margin="0,6,0,0"/></StackPanel></Border>
                </StackPanel>
              </Grid>
              <Border Background="#12161C" CornerRadius="10" Padding="13,10" Margin="0,10,0,18"><TextBlock x:Name="CaptureFeedback" Text="Your camera starts only when you choose. All processing stays on this PC." Foreground="#A9B7C7" FontSize="12" TextAlignment="Center" AutomationProperties.LiveSetting="Polite"/></Border>
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel x:Name="NameArea" Margin="0,0,18,0"><TextBlock Text="PROFILE NAME" FontSize="9" Foreground="#939DAB" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBox x:Name="ProfileName" MaxLength="40" AutomationProperties.Name="Profile name" Width="230" Height="40" HorizontalAlignment="Left"/></StackPanel>
                <StackPanel x:Name="ProfileSummary" Visibility="Collapsed" VerticalAlignment="Center"><TextBlock x:Name="ProfileTitle" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="ProfileDetail" Style="{StaticResource Detail}" Margin="0,5,0,0"/></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom"><Button x:Name="CameraButton" Content="Start camera" Margin="0,0,8,0"/><Button x:Name="MainAction" Content="Begin enrollment  →" Style="{StaticResource Primary}"/><Button x:Name="CancelAction" Content="Cancel" Visibility="Collapsed" Margin="8,0,0,0"/></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Grid Margin="0,17,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="ON-DEVICE BY DESIGN" FontSize="9" Foreground="#6D7989" FontWeight="SemiBold"/><TextBlock x:Name="StorageLabel" Text="Encrypted for your Windows user" Foreground="#A6B1C0" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1"><TextBlock Text="EYE STATE" FontSize="9" Foreground="#6D7989" FontWeight="SemiBold"/><TextBlock x:Name="EyeMetric" Text="Waiting for a frame" Foreground="#A6B1C0" FontSize="11" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="LOCAL INFERENCE" FontSize="9" Foreground="#6D7989" FontWeight="SemiBold"/><TextBlock x:Name="InferenceMetric" Text="YuNet + SFace + MediaPipe" Foreground="#A6B1C0" FontSize="11" Margin="0,5,0,0"/></StackPanel></Grid>
        </StackPanel>

        <StackPanel x:Name="LabPage" Visibility="Collapsed">
          <Border Style="{StaticResource Card}"><StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="A closer look." FontSize="23" FontWeight="SemiBold"/><TextBlock Text="Load up to five JPEG or PNG photos. Images stay in memory." Style="{StaticResource Detail}" Margin="0,6,0,0"/></StackPanel><Button Grid.Column="1" x:Name="ChooseImages" Content="Choose photos"/></Grid><Border Background="#121519" CornerRadius="12" Height="245" Margin="0,20,0,12"><Image x:Name="LabPreview" Stretch="Uniform"/></Border><ComboBox x:Name="ImagePicker" AutomationProperties.Name="Selected photo" MinHeight="30"/><Grid Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="LabName" MaxLength="40" AutomationProperties.Name="Image enrollment name" Margin="0,0,14,0"/><StackPanel Grid.Column="1" Orientation="Horizontal"><Button x:Name="LabEnroll" Content="Enroll photos" Margin="0,0,8,0"/><Button x:Name="LabInspect" Content="Inspect" Margin="0,0,8,0"/><Button x:Name="LabReject" Content="Test photo rejection" Style="{StaticResource Primary}"/></StackPanel></Grid><TextBlock x:Name="LabResult" Text="Choose an image to inspect face quality, eye state, and similarity." Foreground="#A8B8CB" Margin="0,18,0,0"/></StackPanel></Border>
          <Button x:Name="ClearImages" Content="Clear loaded images" Style="{StaticResource Quiet}" HorizontalAlignment="Left" Margin="0,10,0,0"/>
        </StackPanel>

        <StackPanel x:Name="ActivityPage" Visibility="Collapsed"><Border Style="{StaticResource Card}"><StackPanel><Grid Margin="0,0,0,18"><TextBlock Text="This session" FontSize="20" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" HorizontalAlignment="Right"><Button x:Name="ExportActivity" Content="Export JSON" Margin="0,0,8,0"/><Button x:Name="ClearActivity" Content="Clear" Style="{StaticResource Quiet}"/></StackPanel></Grid><TextBlock x:Name="EmptyActivity" Text="A fresh start. Your session events will appear here." Foreground="{StaticResource Muted}" Margin="0,18,0,24"/><StackPanel x:Name="EventList"/><TextBlock Text="Last 100 events · no camera images or face embeddings" Style="{StaticResource Detail}" Margin="0,18,0,0"/></StackPanel></Border></StackPanel>

        <StackPanel x:Name="SettingsPage" Visibility="Collapsed">
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel>
            <TextBlock Text="Windows face sign-in" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,8"/>
            <TextBlock Text="Link this Windows account to your saved guided camera enrollment. Local accounts and Microsoft accounts with a password are supported." Style="{StaticResource Detail}"/>
            <TextBlock x:Name="SignInStatus" Text="Install the sign-in components, then refresh status." Foreground="#A9CFF5" TextWrapping="Wrap" Margin="0,10,0,14" AutomationProperties.LiveSetting="Polite"/>
            <TextBlock Text="Account type and Windows username / Microsoft account email" Style="{StaticResource Detail}" Margin="0,0,0,6"/>
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
              <ComboBox x:Name="SignInAccountKind" SelectedIndex="0" MinHeight="40" Margin="0,0,12,0" AutomationProperties.Name="Windows account type"><ComboBoxItem Content="Local account"/><ComboBoxItem Content="Microsoft account"/></ComboBox>
              <TextBox x:Name="SignInAccount" Grid.Column="1" AutomationProperties.Name="Windows username or Microsoft account email"/>
            </Grid>
            <TextBlock Text="Account password · use your password, not your Windows Hello PIN" Style="{StaticResource Detail}" Margin="0,12,0,6"/>
            <PasswordBox x:Name="SignInPassword" Height="40" MaxLength="256" FontSize="14" Padding="12,6" Background="#14171B" Foreground="#F3F5F8" BorderBrush="#414854" VerticalContentAlignment="Center" AutomationProperties.Name="Windows account password"/>
            <WrapPanel Margin="0,14,0,0"><Button x:Name="LinkSignIn" Content="Link / update account" Style="{StaticResource Primary}" Margin="0,0,8,8"/><Button x:Name="UnlinkSignIn" Content="Disable face sign-in" Margin="0,0,8,8"/><Button x:Name="RefreshSignIn" Content="Refresh status" Style="{StaticResource Quiet}" Margin="0,0,0,8"/></WrapPanel>
            <TextBlock Text="Your PIN and password remain available in Windows sign-in options. Relink after changing your password or face enrollment. This RGB-camera sign-in feature is experimental." Style="{StaticResource Detail}" Margin="0,4,0,0"/>
          </StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Camera &amp; recognition" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,18"/><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your camera" FontWeight="SemiBold"/><TextBlock Text="Used for enrollment and live unlock tests." Style="{StaticResource Detail}" Margin="0,4,16,0"/></StackPanel><ComboBox x:Name="CameraPicker" Grid.Column="1" VerticalAlignment="Center" MinHeight="32" AutomationProperties.Name="Camera device"/></Grid><Button x:Name="RefreshCameras" Content="Refresh cameras" Style="{StaticResource Quiet}" HorizontalAlignment="Right" Padding="8,5" Margin="0,5,0,12"/><Grid><TextBlock Text="Match threshold" FontWeight="SemiBold"/><TextBlock x:Name="ThresholdValue" Text="0.55" HorizontalAlignment="Right" Foreground="{StaticResource Accent}" FontWeight="SemiBold"/></Grid><Slider x:Name="Threshold" Minimum="0.35" Maximum="0.9" Value="0.55" TickFrequency="0.01" IsSnapToTickEnabled="True" Margin="0,12,0,8" AutomationProperties.Name="Match threshold"/><TextBlock Text="More permissive ←                                               → More selective" Style="{StaticResource Detail}"/><TextBlock Text="Cosine similarity, not a confidence percentage. Every live test also requires a fresh blink and open eyes." Style="{StaticResource Detail}" Margin="0,10,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><StackPanel><TextBlock Text="Make yourself at home" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,16"/><CheckBox x:Name="ReduceMotion" Content="Reduce interface motion"/><TextBlock Text="Keep directional cues and progress, with immediate transitions. Your Windows animation preference is always respected." Style="{StaticResource Detail}" Margin="0,7,0,0"/></StackPanel></Border>
          <Border Style="{StaticResource Card}" Margin="0,0,0,14"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Your face profile" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="SettingsProfile" Text="No face enrolled yet." Style="{StaticResource Detail}" Margin="0,7,14,0"/></StackPanel><Button x:Name="DeleteProfile" Content="Delete enrollment" Grid.Column="1" VerticalAlignment="Center" Foreground="#F1A4AB"/></Grid></Border>
          <TextBlock Text="Viso 0.8.2 · Native Windows app" Foreground="#B3BECC" FontWeight="SemiBold" Margin="2,4,0,7"/><TextBlock Text="Unlock tests control the simulator. Link your account above to enable Windows face sign-in. The RGB-camera blink challenge is experimental. Design inspired by Glance." Style="{StaticResource Detail}" Margin="2,0,0,12"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" Background="#202329" BorderBrush="#343A44" BorderThickness="1" CornerRadius="17" Padding="5">
      <StackPanel x:Name="Navigation" Orientation="Horizontal"><Button x:Name="NavFace" Style="{StaticResource Nav}" Content="◎   Your face"/><Button x:Name="NavUnlock" Style="{StaticResource Nav}" Content="◇   Unlock test"/><Button x:Name="NavLab" Style="{StaticResource Nav}" Content="▧   Image lab"/><Button x:Name="NavActivity" Style="{StaticResource Nav}" Content="≋   Activity"/><Button x:Name="NavSettings" Style="{StaticResource Nav}" Content="⚙   Settings"/></StackPanel>
    </Border>
  </Grid>
</Window>

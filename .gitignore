models/*.onnx
models/*.task
models/*.partial
models/licenses/
# Downloaded public fixtures and generated reports
tests/.fixtures/
*.log
*.tsbuildinfo
test-results/
playwright-report/
.env
# Native binaries
desktop/bin/
signin/bin/
